# ci/perfis/alvo1-juiceshop.env
ALVO_ID=alvo1
ALVO_NOME=juice-shop
ALVO_CAMINHO=alvos/juice-shop
ALVO_PORTA=3000
ALVO_HEALTH=/
ALVO_IMAGEM=tcc-juiceshop
ALVO_TEM_GROUND_TRUTH=true
ALVO_DOCKERFILE=ci/alvos/juice-shop.Dockerfile
# Copia do Dockerfile do alvo com data de corte das dependencias npm (D14 revisado).
# O trivy config continua varrendo o Dockerfile original do projeto.
ALVO_CONTEXTO=alvos/juice-shop
ALVO_BUILD_TARGET=
ALVO_PREBUILD=
ALVO_BASE_HERDADA=false
ALVO_TRIVY_CONFIG_ALVO=alvos/juice-shop/Dockerfile
ALVO_TRIVY_CONFIG_PATTERN=
ALVO_FIXTURE=
ALVO_FIXTURE_DESTINO=
# Imagens base fixadas por digest (FROM do Dockerfile do alvo usa tags mutaveis).
# Aplicadas via --build-context, sem alterar o submodulo. Digests verificados em
# 27/09/2026: as camadas coincidem com as das execucoes de validacao de 14 e 23/09.
ALVO_BASES="node:24=node:24@sha256:64af3819f9275802414d7cdc38c27e9d82bd564dec4d4da87d008255d36c63b4 gcr.io/distroless/nodejs24-debian13=gcr.io/distroless/nodejs24-debian13@sha256:b1fc33242cc74151f50c62b4a03d48afd759dccf81279b5f8e401db4546479c1"
