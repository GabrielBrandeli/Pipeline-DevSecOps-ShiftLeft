# ci/perfis/alvo2-uptimekuma.env
ALVO_ID=alvo2
ALVO_NOME=uptime-kuma
ALVO_CAMINHO=alvos/uptime-kuma
ALVO_PORTA=3001
ALVO_HEALTH=/
ALVO_IMAGEM=tcc-uptimekuma
ALVO_TEM_GROUND_TRUTH=false
ALVO_DOCKERFILE=alvos/uptime-kuma/docker/dockerfile
ALVO_CONTEXTO=alvos/uptime-kuma
ALVO_BUILD_TARGET=release
ALVO_PREBUILD="npm ci && npm run build"
ALVO_BASE_HERDADA=true
ALVO_TRIVY_CONFIG_ALVO=alvos/uptime-kuma/docker/dockerfile
ALVO_TRIVY_CONFIG_PATTERN=dockerfile:alvos/uptime-kuma/docker/dockerfile
# D11 (revisado 23/09): admin pre-provisionado + status page publica; DAST sem autenticacao
ALVO_FIXTURE=ci/fixtures/uptime-kuma/data
ALVO_FIXTURE_DESTINO=/app/data
# Imagens base fixadas por digest (FROM do dockerfile do alvo usa tags mutaveis,
# inclusive o ARG BASE_IMAGE do estagio release). Aplicadas via --build-context,
# sem alterar o submodulo. Digests verificados em 27/09/2026: as camadas coincidem
# com as das execucoes de validacao de 14 e 23/09.
ALVO_BASES="louislam/uptime-kuma:base2=louislam/uptime-kuma:base2@sha256:f83db3d20fd5b8c0a875d70c96c6e160b2f61b8d439a97c3c8486a8e2aa54e87 louislam/uptime-kuma:builder-go=louislam/uptime-kuma:builder-go@sha256:50e49d7f27f124a5a086c076387d5419aa3767d88bc2c16354ca52790f709865"
